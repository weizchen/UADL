using namespace std;

// --- Architecture: {{ architecture.name }} ---
int NUM_CORES = {{ architecture.resources.cores }};

// === Cache Hierarchy (Tag-Based, Deterministic) ===
{% for cache in architecture.resources.caches %}
struct {{ cache.level }}_Cache {
    static const int SIZE = {{ cache.size }};
    static const int LINE_SIZE = {{ cache.line_size }};
    static const int ASSOCIATIVITY = {{ cache.associativity }};
    static const int NUM_SETS = {{ cache.size // (cache.line_size * cache.associativity) }};
    static const int HIT_LATENCY = {{ cache.hit_latency }};
    static const int MISS_PENALTY = {{ cache.miss_penalty }};
    
    uint32_t tags[NUM_SETS][ASSOCIATIVITY];
    bool valid[NUM_SETS][ASSOCIATIVITY];
    int lru_counter[NUM_SETS][ASSOCIATIVITY];
    int access_count, hit_count, miss_count;
    
    {{ cache.level }}_Cache() : access_count(0), hit_count(0), miss_count(0) {
        memset(valid, 0, sizeof(valid));
        memset(tags, 0, sizeof(tags));
        memset(lru_counter, 0, sizeof(lru_counter));
    }
    
    int access(uint32_t addr) {
        access_count++;
        uint32_t line_addr = addr / LINE_SIZE;
        uint32_t set_idx = line_addr % NUM_SETS;
        uint32_t tag = line_addr / NUM_SETS;
        
        for (int w = 0; w < ASSOCIATIVITY; w++) {
            if (valid[set_idx][w] && tags[set_idx][w] == tag) {
                hit_count++;
                lru_counter[set_idx][w] = access_count;
                return HIT_LATENCY;
            }
        }
        
        miss_count++;
        int victim = 0;
        int min_lru = lru_counter[set_idx][0];
        for (int w = 0; w < ASSOCIATIVITY; w++) {
            if (!valid[set_idx][w]) { victim = w; break; }
            if (lru_counter[set_idx][w] < min_lru) {
                min_lru = lru_counter[set_idx][w];
                victim = w;
            }
        }
        valid[set_idx][victim] = true;
        tags[set_idx][victim] = tag;
        lru_counter[set_idx][victim] = access_count;
        return HIT_LATENCY + MISS_PENALTY;
    }
};
{{ cache.level }}_Cache cache_{{ cache.level }};
{% endfor %}

int simulate_memory_access(uint32_t addr) {
    int total = 0;
    {% for cache in architecture.resources.caches %}
    {
        int result = cache_{{ cache.level }}.access(addr);
        total += result;
        if (result == {{ cache.level }}_Cache::HIT_LATENCY) return total;
    }
    {% endfor %}
    return total;
}

// === Pipeline Trace ===
{% if architecture._pipeline_enabled %}
struct PipelineTraceEntry {
    const char* name;
    int if_cycle;
    int stall;
};
{% endif %}

// === Core State ===
{% set reg = architecture.resources.registers[0] %}
struct CoreState {
    int core_id;
    bool halt;
    uint64_t total_cycles;
    
    // {{ architecture.name }}: {{ reg.count }} general-purpose registers
    int32_t {{ reg.name }}[{{ reg.count }}];
    uint32_t PC;
    
    {% if architecture._pipeline_enabled %}
    int pipeline_cycle;
    int reg_available_at[{{ reg.count }}];
    int stall_cycles;
    int flush_count;
    vector<PipelineTraceEntry> pipeline_trace;
    {% endif %}
    
    CoreState(int id) : core_id(id), halt(false), total_cycles(0), PC(0) {
        memset({{ reg.name }}, 0, sizeof({{ reg.name }}));
        {% if architecture._pipeline_enabled %}
        pipeline_cycle = 0;
        memset(reg_available_at, 0, sizeof(reg_available_at));
        stall_cycles = 0;
        flush_count = 0;
        {% endif %}
    }
    
    {% if architecture._pipeline_enabled %}
    void reset_pipeline() {
        memset(reg_available_at, 0, sizeof(reg_available_at));
    }
    {% endif %}
};

vector<CoreState> cores;

// === Memory (Harvard Architecture) ===
{% for mem in architecture.resources.memory %}
vector<uint{{ mem.width }}_t> {{ mem.name }}({{ mem.size }}, 0);
{% endfor %}

// === Instruction Decoder ({{ architecture.name }}) ===
{% if architecture.encoding == 'riscv32' %}
{% from 'decoders/riscv32.j2' import decode_step, dispatch_cond, enforce_zero_reg with context %}
{% include 'decoders/riscv32.j2' %}
{% elif architecture.encoding == 'armv7' %}
{% from 'decoders/armv7.j2' import decode_step, dispatch_cond, enforce_zero_reg with context %}
{% include 'decoders/armv7.j2' %}
{% endif %}

// === Instruction Execution ===
void step(CoreState& core) {
    if (core.halt) return;
    
    bool _branch_taken = false;
    uint32_t _mem_addr = 0;
    
    // Fetch (memcpy to avoid strict-aliasing UB on uint8_t vector)
    uint32_t current_pc = core.PC;
    uint32_t raw_inst = 0;
    if (current_pc + 4 <= InstructionMem.size()) {
        memcpy(&raw_inst, &InstructionMem[current_pc], 4);
    }

    // Increment PC
    core.PC += 4;
    
    // Decode
{{ decode_step() }}
    
    // Execute: dispatch
    {% for inst in architecture.instructions %}
{{ dispatch_cond(inst, loop) }}
        // {{ inst.name }}
        {% if architecture._pipeline_enabled %}
        {
            int _src_avail = 0;
            {% for src_idx in inst._pipeline.src_indices %}
            _src_avail = max(_src_avail, core.reg_available_at[{{ src_idx }}]);
            {% endfor %}
            int _if_cycle = core.pipeline_cycle;
            int _stall = 0;
            if (_src_avail > core.pipeline_cycle) {
                _stall = _src_avail - core.pipeline_cycle;
                core.stall_cycles += _stall;
                core.pipeline_cycle = _src_avail;
            }
            core.pipeline_cycle++;
            if (core.pipeline_trace.size() < 30) {
                core.pipeline_trace.push_back({"{{ inst.name }}", _if_cycle, _stall});
            }
        }
        {% else %}
        core.total_cycles += {{ inst.latency }};
        {% endif %}
        
{{ inst._generated_cpp }}
        
{{ enforce_zero_reg() }}
        
        {% if architecture._pipeline_enabled %}
        {% if inst._pipeline.dst_index is not none %}
        {% if inst._pipeline.is_load %}
        {% if architecture.pipeline.forwarding %}
        core.reg_available_at[{{ inst._pipeline.dst_index }}] = core.pipeline_cycle + 1;
        {% else %}
        core.reg_available_at[{{ inst._pipeline.dst_index }}] = core.pipeline_cycle + 2;
        {% endif %}
        {% else %}
        {% if architecture.pipeline.forwarding %}
        core.reg_available_at[{{ inst._pipeline.dst_index }}] = core.pipeline_cycle;
        {% else %}
        core.reg_available_at[{{ inst._pipeline.dst_index }}] = core.pipeline_cycle + 2;
        {% endif %}
        {% endif %}
        {% endif %}
        {% endif %}
        
        {% if inst.get('mem_access', false) %}
        {% if architecture._pipeline_enabled %}
        core.pipeline_cycle += simulate_memory_access(_mem_addr);
        {% else %}
        core.total_cycles += simulate_memory_access(_mem_addr);
        {% endif %}
        {% endif %}
    }
    {% endfor %}
    else {
        cerr << "Unknown instruction at PC=" << current_pc << " raw=0x" << hex << raw_inst << dec << endl;
        core.halt = true;
    }
    
    {% if architecture.encoding == 'armv7' %}
    // Restore barrel-shifted register
    if (_has_shift) {
        core.{{ architecture.resources.registers[0].name }}[rm] = _saved_rm;
    }
    {% endif %}
    
    {% if architecture._pipeline_enabled %}
    if (_branch_taken) {
        core.pipeline_cycle += {{ architecture.pipeline.branch_penalty }};
        core.flush_count++;
    }
    {% endif %}
}

// === Main ===
int main(int argc, char** argv) {
    if (argc < 2) {
        cerr << "Usage: " << argv[0] << " <binary_file>" << endl;
        return 1;
    }

    // Load .mem format into Memory
    FILE* f = fopen(argv[1], "rb");
    if (!f) {
        cerr << "Error opening file " << argv[1] << endl;
        return 1;
    }

    char magic[4];
    if (fread(magic, 1, 4, f) != 4 || strncmp(magic, "UADL", 4) != 0) {
        cerr << "Invalid memory format (missing UADL magic) in " << argv[1] << endl;
        fclose(f);
        return 1;
    }

    uint32_t vaddr, size_bytes;
    while (fread(&vaddr, 1, 4, f) == 4 && fread(&size_bytes, 1, 4, f) == 4) {
        std::vector<uint8_t> buf(size_bytes);
        if (fread(buf.data(), 1, size_bytes, f) != size_bytes) break;
        
        // Copy to InstructionMem if within bounds
        if (vaddr < InstructionMem.size()) {
            uint32_t copy_size = std::min(size_bytes, (uint32_t)InstructionMem.size() - vaddr);
            memcpy(&InstructionMem[vaddr], buf.data(), copy_size);
        }
        
        // Copy to DataMem if within bounds
        if (vaddr < DataMem.size()) {
            uint32_t copy_size = std::min(size_bytes, (uint32_t)DataMem.size() - vaddr);
            memcpy(&DataMem[vaddr], buf.data(), copy_size);
        }
    }
    fclose(f);

    // Init cores
    for (int c = 0; c < NUM_CORES; c++) {
        cores.push_back(CoreState(c));
    }

    // Execute
    bool active = true;
    while (active) {
        active = false;
        for (int c = 0; c < NUM_CORES; c++) {
            if (!cores[c].halt) {
                active = true;
                step(cores[c]);
            }
        }
    }

    // Output
    uint64_t max_cycles = 0;
    cout << "--- Final CPU State ---" << endl;
    for (int c = 0; c < NUM_CORES; c++) {
        {% if architecture._pipeline_enabled %}
        cores[c].total_cycles = cores[c].pipeline_cycle;
        {% endif %}
        cout << "[Core " << c << "]" << endl;
        cout << "  PC: " << cores[c].PC << endl;
        for (int i = 0; i < {{ reg.count }}; i++) {
            if (cores[c].{{ reg.name }}[i] != 0) {
                cout << "  {{ reg.name }}[" << i << "]: " << cores[c].{{ reg.name }}[i] << endl;
            }
        }
        cout << "  Total Cycles: " << cores[c].total_cycles << endl;
        {% if architecture._pipeline_enabled %}
        cout << "  Pipeline Stalls: " << cores[c].stall_cycles << endl;
        cout << "  Pipeline Flushes: " << cores[c].flush_count << endl;
        {% endif %}
        if (cores[c].total_cycles > max_cycles) max_cycles = cores[c].total_cycles;
    }
    cout << "--- Performance Data ---" << endl;
    cout << "Total Workload Cycles: " << max_cycles << endl;
    {% for cache in architecture.resources.caches %}
    cout << "{{ cache.level }} Cache: " << cache_{{ cache.level }}.hit_count << " hits, " 
         << cache_{{ cache.level }}.miss_count << " misses ("
         << (cache_{{ cache.level }}.access_count > 0 ? (100.0 * cache_{{ cache.level }}.hit_count / cache_{{ cache.level }}.access_count) : 0) 
         << "% hit rate)" << endl;
    {% endfor %}
    cout << "--- Data Memory Dump ---" << endl;
    for (int j = 0; j < 1024; j += 4) {
        int32_t val;
        memcpy(&val, &DataMem[j], 4);
        if (val != 0) {
            cout << "DataMem[" << j << "]: " << val << endl;
        }
    }
    
    {% if architecture._pipeline_enabled %}
    if (!cores[0].pipeline_trace.empty()) {
        cout << "--- Pipeline Diagram ---" << endl;
        int _max_c = 0;
        for (auto& e : cores[0].pipeline_trace) {
            int wb = e.if_cycle + e.stall + 5;
            if (wb > _max_c) _max_c = wb;
        }
        if (_max_c > 40) _max_c = 40;
        
        printf("%-8s", "Instr");
        for (int c = 0; c < _max_c; c++) printf("%3d ", c + 1);
        printf("\n");
        printf("%-8s", "--------");
        for (int c = 0; c < _max_c; c++) printf("----");
        printf("\n");
        
        for (auto& e : cores[0].pipeline_trace) {
            printf("%-8s", e.name);
            for (int c = 0; c < _max_c; c++) {
                if (c == e.if_cycle) printf(" IF ");
                else if (c == e.if_cycle + 1) printf(" ID ");
                else if (e.stall > 0 && c > e.if_cycle + 1 && c <= e.if_cycle + 1 + e.stall) printf(" ** ");
                else if (c == e.if_cycle + 2 + e.stall) printf(" EX ");
                else if (c == e.if_cycle + 3 + e.stall) printf(" ME ");
                else if (c == e.if_cycle + 4 + e.stall) printf(" WB ");
                else printf("    ");
            }
            printf("\n");
        }
    }
    {% endif %}

    return 0;
}
