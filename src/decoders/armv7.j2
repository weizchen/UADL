    {% elif inst.format == 'DPI' %}
    {% if not loop.first %}else {% endif %}if ((d.type_ & 0x6) == 0x0 && d.is_imm && d.opcode == {{ inst.opcode }}) {
    {% elif inst.format == 'LS' %}
    {% if not loop.first %}else {% endif %}if ((d.type_ & 0x6) == 0x2 && !d.is_imm && ((raw_inst >> 20) & 1) == {{ inst.opcode }}) {
    {% elif inst.format == 'BR' %}
    {% if not loop.first %}else {% endif %}if ((d.type_ & 0x6) == 0x4 && ((raw_inst >> 24) & 0xF) == {{ inst.opcode }}) {
