# --- UADL Project .gitignore ---

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
venv/
.venv/
.env

# Generated simulator artifacts
poc/generated_simulator.cpp
poc/sim
poc/sim.dSYM/
src/generated_sim_*.cpp
src/sim_*
!src/sim_universal.j2
!src/sim_template.j2
!src/gpu_sim_template.j2

# Phase C/D experiment outputs (regenerated on every run)
src/experiments/results/feedback/
src/experiments/results/experiment_*.csv
src/experiments/results/latest_results*.json
src/experiments/results/tmp_*
src/experiments/prompts/
*.telem.json
*.symtab.json
tmp_arm_exp.log

# Assembled binaries
poc/tests/*.bin
src/tests/**/*.bin
src/tests/**/*.o
src/tests/**/*.elf

# Generated assembly (from .c files via c_compiler.py)
# NOTE: We track .asm files that are hand-written (arithmetic, control_flow, memory, threads, multiply)
# but NOT .asm files generated from .c source (simple, parallel)
poc/tests/simple.asm
poc/tests/parallel.asm

# C/C++ build artifacts
*.o
*.obj
*.d
*.slo
*.lo
*.gch
*.pch
*.ilk
*.pdb
*.so
*.dylib
*.dll
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.dwo
*.dSYM/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
